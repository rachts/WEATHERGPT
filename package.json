{
  "name": "weathergpt",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"try{require('fs').rmSync('public/sw.js',{force:true});require('fs').rmSync('public/sw.js.map',{force:true});require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/run-all-tests.ts",
    "seed": "node scripts/seed.mjs",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "refresh:demo": "tsx scripts/refresh-live-demo-data.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.69",
    "@ai-sdk/openai": "4.0.66",
    "@ai-sdk/react": "4.0.102",
    "@prisma/client": "^5.22.0",
    "@serwist/next": "^9.0.12",
    "ai": "7.0.99",
    "maplibre-gl": "^4.7.1",
    "next": "14.2.35",
    "pino": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "serwist": "^9.0.12",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2"
  }
}
