# WeatherGPT Environment Configuration
# SIH 2026 · PS 26068 · MoES / India Meteorological Department

# Node Environment ("development" | "production" | "test")
NODE_ENV="development"

# Database URL (PostgreSQL + Prisma) - optional, local JSON fallback active if unconfigured
# INSTANT JUDGE DEPLOYMENT NOTE: Judges can use a live read-only cloud PostgreSQL instance (Neon / Supabase)
# to execute `npm run build`, migrations, and test suites instantly without running local Docker containers:
# DATABASE_URL="postgresql://read-only-user:pass@ep-weathergpt-sih2026.ap-southeast-1.aws.neon.tech/weathergpt?sslmode=require&pgbouncer=true"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/weathergpt?schema=public&connection_limit=10&pool_timeout=20"

# Security & Alert Ingestion Secret (strictly required for POST /api/alerts ingestion)
# Generate with: openssl rand -hex 32
# CAUTION: The route fails closed if this is unset or < 16 chars. Never commit real tokens or defaults!
ALERT_INGESTION_TOKEN=""


# Shared Distributed Cache & Rate Limiter (Upstash Redis REST - optional, degrades to bounded in-memory sliding window if unset)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Dynamic Rate Limiting Configuration (requests per window)
RATE_LIMIT_MAX_REQUESTS="60"
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_AI_MAX_REQUESTS="30"
RATE_LIMIT_WEATHER_MAX_REQUESTS="120"
RATE_LIMIT_ALERT_MAX_REQUESTS="15"

# Conversational AI Provider Keys (for Vercel AI SDK - optional, runs deterministic mock briefing if unset)
GEMINI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENAI_API_KEY=""

# data.gov.in IMD Resource API Key (optional - documented Open-Meteo fallback is active)
DATA_GOV_IN_API_KEY=""

# SMS & Dissemination Gateways (Fast2SMS / Msg91 for India, Twilio for international)
FAST2SMS_API_KEY=""
MSG91_AUTH_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
IVR_GATEWAY_URL=""
IVR_GATEWAY_API_KEY=""

# Web Push Notification Keys (VAPID - free native browser notifications on Android & Desktop)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:weathergpt-alerts@nic.in"

# Application Host URL (Public client-facing URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Client Runtime Flags & Defaults
NEXT_PUBLIC_DEFAULT_DISTRICT="Raigad"
NEXT_PUBLIC_DEFAULT_STATE="Maharashtra"
NEXT_PUBLIC_APP_NAME="WeatherGPT"
NEXT_PUBLIC_APP_VERSION="1.0.0"
