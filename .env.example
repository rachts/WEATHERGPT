# WeatherGPT Environment Configuration
# SIH 2026 · PS 26068 · MoES / India Meteorological Department

# Database URL (PostgreSQL + Prisma) - optional, local JSON fallback active if unconfigured
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/weathergpt?schema=public&connection_limit=5"

# Security & Alert Ingestion Secret (required for POST /api/alerts ingestion)
ALERT_INGESTION_TOKEN="replace-with-cryptographically-secure-token-min-16-chars"

# Shared Distributed Cache & Rate Limiter (Upstash Redis REST - optional, degrades to memory cache if unset)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# data.gov.in IMD Resource API Key (optional - documented Open-Meteo fallback is active)
DATA_GOV_IN_API_KEY=""

# Application Host URL (Public client-facing URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Client Runtime Flags
NEXT_PUBLIC_DEFAULT_DISTRICT="Raigad"
NEXT_PUBLIC_DEFAULT_STATE="Maharashtra"
NEXT_PUBLIC_APP_NAME="WeatherGPT"
NEXT_PUBLIC_APP_VERSION="1.0.0"
