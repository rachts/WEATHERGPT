# WeatherGPT Environment Configuration
# SIH 2026 · PS 26068 · MoES / India Meteorological Department

# Google Gemini API Key (phrasing and intent resolution only - never authors values)
GEMINI_API_KEY="your-gemini-api-key-here"

# PostgreSQL Database URL with pgvector support
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/weathergpt?schema=public"

# data.gov.in IMD Resource API Key (optional - documented Open-Meteo fallback is active)
DATA_GOV_IN_API_KEY=""

# Application Host URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
