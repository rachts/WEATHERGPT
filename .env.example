# WeatherGPT Environment Configuration
# SIH 2026 · PS 26068 · MoES / India Meteorological Department

# Database URL (PostgreSQL + Prisma) - optional, local JSON fallback active if unconfigured
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/weathergpt?schema=public"

# data.gov.in IMD Resource API Key (optional - documented Open-Meteo fallback is active)
DATA_GOV_IN_API_KEY=""

# Application Host URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Security & Alert Ingestion Secret (required for POST /api/alerts ingestion)
ALERT_INGESTION_TOKEN="replace-with-cryptographically-secure-token"

# Shared Distributed Cache (Upstash Redis REST - optional, degrades to memory cache if unset)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
